# Copy to secrets.yaml and fill in your values (secrets.yaml is git-ignored)
wifi_ssid: "YourWiFiName"          # 2.4 GHz network (the ESP32 has no 5 GHz)
wifi_password: "YourWiFiPassword"
ota_password: "choose-a-password"   # protects over-the-air firmware updates
ha_url: "http://192.168.1.20:8123"  # Home Assistant, plain HTTP, reachable from the ESP32 (used for cover art)
